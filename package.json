{
  "name": "@jcyao/qoder-wechat-bridge",
  "version": "0.1.1",
  "description": "Bridge personal WeChat (iLink/OpenClaw official channel) to a local Qoder agent session.",
  "keywords": [
    "qoder",
    "wechat",
    "weixin",
    "ilink",
    "openclaw",
    "agent",
    "im",
    "bot",
    "bridge",
    "cli"
  ],
  "license": "MIT",
  "author": "joke_yao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joker-yjc/qoder-wechat-bridge.git"
  },
  "homepage": "https://github.com/joker-yjc/qoder-wechat-bridge#readme",
  "bugs": {
    "url": "https://github.com/joker-yjc/qoder-wechat-bridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qoder-wechat": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "login": "npm run build && node dist/cli.js login",
    "start": "npm run build && node dist/cli.js run",
    "status": "node dist/cli.js status",
    "prepublishOnly": "npm run typecheck && npm run build && node scripts/check-publish.mjs"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "silk-wasm": "^3.7.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.3"
  }
}
